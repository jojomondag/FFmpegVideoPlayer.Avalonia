<Project>
  <PropertyGroup>
    <Version>3.1.0-preview.1</Version>
    <AvaloniaVersion>12.1.0</AvaloniaVersion>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep generated verification/build output out of SDK default items. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
    <Content Remove="artifacts\**" />
  </ItemGroup>
</Project>
