<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="Avalonia.FFmpegVideoPlayer.VideoPlayerControl"
             x:Name="Root"
             ClipToBounds="True">

    <UserControl.Styles>
        <!-- Icon-only button: transparent background, subtle hover -->
        <Style Selector="Button.iconButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="{Binding ButtonPadding, ElementName=Root}"/>
            <Setter Property="CornerRadius" Value="{Binding ButtonCornerRadius, ElementName=Root}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.iconButton:pointerover">
            <Setter Property="Background" Value="#18000000"/>
        </Style>
        <Style Selector="Button.iconButton:pressed">
            <Setter Property="Background" Value="#28000000"/>
        </Style>

    </UserControl.Styles>

    <!-- Video + controls overlay in same cell so controls match video width -->
    <Grid>
        <!-- Video View -->
        <Border Name="VideoBorder" Background="{Binding VideoBackground, ElementName=Root}"/>

        <!-- Controls Panel - overlaid at bottom of video -->
        <Border Name="ControlPanelBorder"
                Background="White"
                Padding="{Binding ControlPanelPadding, ElementName=Root}"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                ClipToBounds="True">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">

                <!-- Open File Button -->
                <Button Name="OpenButton" Grid.Column="0" Margin="0,0,2,0"
                        Classes="iconButton" Click="OnOpenClick">
                    <Path Name="FolderIcon"
                          Width="{Binding IconSize, ElementName=Root}"
                          Height="{Binding IconSize, ElementName=Root}"
                          Stretch="Uniform" Fill="#333333"/>
                </Button>

                <!-- Play/Pause Button -->
                <Button Name="PlayPauseButton" Grid.Column="1" Margin="0,0,2,0"
                        Classes="iconButton" Click="OnPlayPauseClick">
                    <Path Name="PlayPauseIcon"
                          Width="{Binding IconSize, ElementName=Root}"
                          Height="{Binding IconSize, ElementName=Root}"
                          Stretch="Uniform" Fill="#333333"/>
                </Button>

                <!-- Stop Button -->
                <Button Name="StopButton" Grid.Column="2" Margin="0,0,4,0"
                        Classes="iconButton" Click="OnStopClick">
                    <Path Name="StopIcon"
                          Width="{Binding IconSize, ElementName=Root}"
                          Height="{Binding IconSize, ElementName=Root}"
                          Stretch="Uniform" Fill="#333333"/>
                </Button>

                <!-- Current Time -->
                <TextBlock Name="CurrentTimeText" Grid.Column="3"
                           Text="00:00"
                           VerticalAlignment="Center" Margin="0,0,4,0"
                           FontSize="{Binding ControlFontSize, ElementName=Root}"/>

                <!-- Seek Bar -->
                <Slider Name="SeekBar" Grid.Column="4"
                        Minimum="0" Maximum="100" Value="0"
                        MinWidth="180"
                        VerticalAlignment="Center" Margin="0,0,4,0"/>

                <!-- Total Time -->
                <TextBlock Name="TotalTimeText" Grid.Column="5"
                           Text="00:00"
                           VerticalAlignment="Center" Margin="0,0,4,0"
                           FontSize="{Binding ControlFontSize, ElementName=Root}"/>

                <!-- Volume Icon (mute toggle) -->
                <Button Name="VolumeButton" Grid.Column="6" Margin="0,0,0,0"
                        Classes="iconButton" Click="OnMuteClick">
                    <Path Name="VolumeIcon"
                          Width="{Binding IconSize, ElementName=Root}"
                          Height="{Binding IconSize, ElementName=Root}"
                          Stretch="Uniform" Fill="#333333"/>
                </Button>

                <!-- Volume Slider -->
                <Slider Name="VolumeSlider" Grid.Column="7"
                        Width="50" MinWidth="0" Minimum="0" Maximum="100" Value="100"
                        VerticalAlignment="Center"/>

                <!-- Fullscreen Toggle Button -->
                <Button Name="FullscreenButton" Grid.Column="8" Margin="2,0,0,0"
                        Classes="iconButton" Click="OnFullscreenClick">
                    <Path Name="FullscreenIcon"
                          Width="{Binding IconSize, ElementName=Root}"
                          Height="{Binding IconSize, ElementName=Root}"
                          Stretch="Uniform" Fill="#333333"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
